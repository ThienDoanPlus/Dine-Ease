INSERT INTO restaurants (id, name, description, address, phone_contact, commission_rate, status, owner_id, avg_rating, image_main, avg_price, cuisine_id, created_at, updated_at) VALUES 
(1, 'Yume Sushi Central', 'Tọa lạc tại trung tâm Quận 1 sôi động, Yume Sushi Central mang đến một hành trình ẩm thực Nhật Bản tinh tế. Không gian được thiết kế theo phong cách Zen yên bình.', '123 Lê Lợi, Quận 1, TP. HCM', '0281234567', 15.0, 'ACTIVE', 2, 4.8, 'https://images.unsplash.com/photo-1579871494447-9811cf80d66c?w=1200', 500000.00, 2, NOW(), NOW()),
(2, 'Mamma Mia', 'Nhà hàng Ý đích thực với Pizza nướng củi và Pasta làm thủ công mỗi ngày. Không gian lãng mạn, thích hợp hẹn hò.', '45 Thảo Điền, Quận 2, TP. HCM', '0287654321', 15.0, 'ACTIVE', 3, 4.8, 'https://images.unsplash.com/photo-1559339352-11d035aa65de?w=800', 450000.00, 3, NOW(), NOW()),
(3, 'The Bull Steakhouse', 'Trải nghiệm bò Wagyu A5 và Tomahawk thượng hạng nướng trên đá nóng núi lửa. Bộ sưu tập rượu vang phong phú.', '25 Ngô Thời Nhiệm, Quận 3, TP. HCM', '0912333444', 20.0, 'ACTIVE', 4, 4.7, 'https://images.unsplash.com/photo-1544025162-d76694265947?w=800', 900000.00, 6, NOW(), NOW()),
(4, 'Sakura Garden Deli', 'Ẩm thực Nhật Bản truyền thống giữa khu vườn hoa anh đào. Có phục vụ các set bento và trà đạo.', '18 Phan Xích Long, Quận Phú Nhuận, TP.HCM', '0988777666', 15.0, 'ACTIVE', 5, 4.8, 'https://images.unsplash.com/photo-1553621042-f6e147245754?w=800', 350000.00, 2, NOW(), NOW()),
(5, 'L Escale Restaurant', 'Ẩm thực Việt Nam sáng tạo kết hợp phong cách Fine Dining đẳng cấp từ Pháp. View sông Sài Gòn tuyệt đẹp.', '90 Tôn Đức Thắng, Quận 1, TP. HCM', '0933222111', 12.0, 'ACTIVE', 6, 4.6, 'https://images.unsplash.com/photo-1544124499-58912cbddaad?w=800', 700000.00, 1, NOW(), NOW());

