INSERT INTO menu_items (id, name, description, price, is_bestseller, status, category_id, restaurant_id, created_at, updated_at) VALUES
(1, 'Gỏi cuốn tôm thịt', 'Tôm tươi, thịt ba rọi kèm bún và rau thơm, chấm mắm nêm pha sẵn', 45000, 1, 'AVAILABLE', 1, 1, NOW(), NOW()),
(2, 'Sashimi Cá Hồi', '5 miếng cá hồi tươi sống nhập khẩu Na Uy, ăn kèm gừng hồng và wasabi tươi', 180000, 1, 'AVAILABLE', 2, 1, NOW(), NOW()),
(3, 'Combo Sushi Yume 1', 'Gồm 12 miếng sushi tổng hợp đặc biệt của bếp trưởng, thay đổi theo ngày.', 450000, 1, 'AVAILABLE', 2, 1, NOW(), NOW()),
(4, 'Mì Udon Bò', 'Sợi mì Udon dai ngon cùng thịt bò Mỹ thái mỏng và nước dùng Dashi đậm đà', 125000, 0, 'AVAILABLE', 3, 1, NOW(), NOW()),
(5, 'Trà đào cam sả', 'Giải nhiệt mùa hè', 45000, 0, 'AVAILABLE', 4, 1, NOW(), NOW()),
(6, 'Pizza Margherita', 'Pizza nướng củi chuẩn Napoli với sốt cà chua San Marzano và phô mai Mozzarella tươi', 250000, 1, 'AVAILABLE', 5, 2, NOW(), NOW()),
(7, 'Spaghetti Carbonara', 'Mì Ý sốt kem phô mai, trứng và thịt heo muối Guanciale', 280000, 1, 'AVAILABLE', 5, 2, NOW(), NOW()),
(8, 'Bò Tomahawk 1.2kg', 'Lõi vai bò Úc kèm xương, nướng hoàn hảo, phục vụ cho 3-4 người', 1800000, 1, 'AVAILABLE', 6, 3, NOW(), NOW());

